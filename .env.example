# Endereço público do sistema (ex.: https://periferica.vercel.app). Precisa ser o mesmo cadastrado no app da Meta.
SITE_URL=

# Banco Turso (turso.tech). Sem isso, o desenvolvimento local usa o arquivo periferica-local.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Login do administrador principal. Senha com 8+ caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Sabrina
# Chave que assina as sessões de login (32+ caracteres aleatórios).
SESSION_SECRET=

# Chave do agendador de publicações (16+ caracteres). A mesma vai no secret CRON_SECRET do GitHub.
CRON_SECRET=

# Cloudinary (imagens e vídeos das publicações)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Meta (Facebook + Instagram) — app do tipo "Empresa" em developers.facebook.com
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# Chave que criptografa os tokens das contas: 32 bytes em base64.
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SOCIAL_TOKEN_KEY=

# Envio de emails (link de "Esqueci minha senha"). Pode usar os mesmos dados do Periflow.
# Opção 1: servidor SMTP próprio (ex.: cPanel). Porta 465 = SSL; 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Opção 2: Resend (resend.com), se não usar SMTP.
RESEND_API_KEY=
# Remetente, ex.: Periférica <sistema@periferica.me>
EMAIL_FROM=
